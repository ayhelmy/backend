# Required secrets
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
DB_NAME=simlearn
DB_USER=simlearn_user
DB_PASSWORD=your-db-password

# Optional database host/port for local development
DB_HOST=localhost
DB_PORT=5432

# Redis configuration (optional)
REDIS_URL=redis://localhost:6379

# Optional storage path overrides for Railway / cloud
# Use absolute paths in the container if needed, otherwise relative paths resolve to the project root.
SIMULATION_STORAGE_PATH=storage/simulations
THUMBNAIL_STORAGE_PATH=storage/thumbnails
LESSON_FILES_STORAGE_PATH=storage/lesson-files

# Optional runtime configuration
NODE_ENV=production
PORT=5000
API_VERSION=v1
# Multiple origins may be comma-separated.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
SWAGGER_ENABLED=true
