# ──────────────────────────────────────────────
# Bedo SimuLearn Backend — Environment Variables
# Copy to .env for local dev. In Railway, set these under
# Project → Service → Variables (never commit real values).
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# PostgreSQL
# In Railway: add a Postgres service and set
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# which takes precedence over the DB_* vars below (they can then be omitted).
# Set DB_SSL=true only when connecting through Railway's public TCP proxy.
DATABASE_URL=
DB_SSL=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simlearn_dev
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
# In Railway: add a Redis service and set
#   REDIS_URL=${{Redis.REDIS_URL}}
# which takes precedence over the REDIS_* vars below.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
EMAIL_FROM=

# AWS S3 — currently unused (no S3 code is wired up; all uploads go to local
# disk / the Railway Volume). Leave blank unless you migrate file storage to S3.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Public origin of THIS backend, used for absolute media/WebGL URLs.
# On Railway it defaults to https://$RAILWAY_PUBLIC_DOMAIN, so usually leave blank.
PUBLIC_BASE_URL=

# Reverse-proxy hops in front of Node. Railway = 1; the Vercel frontend
# proxies /api/v1 through to Railway, so use 2 in production.
TRUST_PROXY_HOPS=1

# CORS — comma-separated list of allowed frontend origins in production
# (e.g. "https://app.yourdomain.com,https://staging-app.yourdomain.com").
# config.cors.origin (used to build LTI redirect URLs) is always the FIRST
# entry in this list.
CORS_ORIGIN=http://localhost:3000

# Cookie domain — leave BLANK for local dev AND for Vercel + Railway: the
# frontend proxies /api/v1 to this backend, so the refresh cookie is set
# host-only on the Vercel domain. Only set it (e.g. .yourdomain.com) if the
# frontend calls the backend directly on a sibling subdomain.
COOKIE_DOMAIN=

# Swagger
SWAGGER_ENABLED=true

# WebGL Simulation Storage
# Local path (relative to backend root) where extracted WebGL builds are
# stored. In production this directory must sit under the Railway Volume
# mount path (see railway.json / deployment guide) or uploads are lost on
# every redeploy.
SIMULATION_STORAGE_PATH=storage/simulations
MAX_UPLOAD_MB=500

# LTI 1.3 Integration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LTI_KEY_ENCRYPTION_SECRET=
# Public base URL of THIS backend — must exactly match the redirect_uri
# registered with each LMS platform (e.g. https://api.yourdomain.com).
LTI_TOOL_BASE_URL=
LTI_LAUNCH_TOKEN_TTL=5m
LTI_STATE_TTL_SECONDS=600
