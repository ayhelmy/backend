# ──────────────────────────────────────────────
# Bedo SimuLearn Backend — Environment Variables
# Copy to .env and fill in real values
# SRS refs: §2.3 Operating Environment, §5 NFR-04 Security
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# PostgreSQL — SRS §2.3, §9 Database Design
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simlearn_dev
DB_USER=postgres
DB_PASSWORD=bedo
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis — SRS §2.3 (Cache/Sessions), §8.1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — SRS §4.1 AUTH-02, §7.1 Login Flow
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email — SRS §4.12 MSG-03, §8.1 Notification Service
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=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
EMAIL_FROM=z.moawad@bedoeg.com

# AWS S3 — SRS §2.3, §4.15 CMS-01, §8.1 File Service
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=simlearn-uploads
AWS_CLOUDFRONT_URL=

# Rate Limiting — SRS §5 NFR-04
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
# CORS_ORIGIN=https://172.20.44.1:3000

# Swagger — SRS §4.16 API-01
SWAGGER_ENABLED=true
NEXT_PUBLIC_API_URL=https://172.20.44.1:5000/api/v1

# WebGL Simulation Storage — SRS §4.7 SIM-01
# Local path (relative to backend root) where extracted WebGL builds are stored.
SIMULATION_STORAGE_PATH=storage/simulations
# Maximum upload size in MB (default 500)
MAX_UPLOAD_MB=500

# LTI 1.3 Integration (Phase 1 — registration + security)
# Master key encrypting tool signing-key private material at rest (AES-256-GCM). Rotate by re-encrypting all lti_tool_keys rows if ever changed.
LTI_KEY_ENCRYPTION_SECRET=dev_change_me_lti_key_encryption_secret_min_32_chars
# Public base URL of THIS backend — used to build the redirect_uri sent to LMS platforms during OIDC login initiation.
LTI_TOOL_BASE_URL=https://172.20.44.1:5000
LTI_LAUNCH_TOKEN_TTL=5m
LTI_STATE_TTL_SECONDS=600